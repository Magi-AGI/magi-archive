# AtomSpace mirror ops tunables. Copy to /etc/atomspace-mirror.env, root:root, mode 0644.
# systemd reads it as root; it holds NO DB credentials and NO app secrets, by design.
#
# These SIDECAR_* values must also be in /home/ubuntu/magi-archive/.env.production, so web, drain and sidecar
# all agree. Web does not read this file, and the Ruby clients otherwise default to a different socket path.
SIDECAR_RUN_DIR=/run/atomspace-mirror
SIDECAR_RUN_DIR_MODE=0750
SIDECAR_SOCKET_MODE=660
SIDECAR_PORT=9407
# SIDECAR_ALLOW_NONLOOPBACK must NEVER be set: it would expose unauthenticated /apply and /bulk_load.

# Mechanism-3 sidecar read timeout, for the O(n) /projection_index at this corpus size.
ATOMSPACE_DRIFT_READ_TIMEOUT=60

# Read-your-writes bounds. They matter to web, so also set them in .env.production to change them.
READ_YOUR_WRITES_MAX_WAIT_SECONDS=2
READ_YOUR_WRITES_POLL_INTERVAL_MS=50

# THESE DO NOT LIVE HERE. They belong in /home/ubuntu/magi-archive/.env.production, the file web sources:
#   ATOMSPACE_MIRRORING_ENABLED=true        master gate, set only at the activation step
#   ATOMSPACE_READ_GRANTS=user:<name>,...   only principals entitled to the Space-global view (G-AUDIENCE)
#   ATOMSPACE_ADMIN_GRANTS=user:<name>,...  read + mcp:atomspace:admin
#   ATOMSPACE_QUARANTINE_DELETE_ENABLED     unset except inside a declared maintenance window
